+    BattleObservation IroncladBattleEnv::reset(std::uint64_t seed, MonsterEncounter encounter, int ascension) {
+        if (ascension != 0) {
+            throw std::invalid_argument("the minimal battle slice supports ascension 0 only");
+        }
+        if (encounter != ME::JAW_WORM && encounter != ME::CULTIST && encounter != ME::TWO_LOUSE) {
+            throw std::invalid_argument("encounter is outside the minimal battle slice");
+        }
+        gc_ = std::make_unique<GameContext>(CharacterClass::IRONCLAD, seed, ascension);
+        gc_->floorNum = 1;
+        gc_->curRoom = Room::MONSTER;
+        gc_->info.encounter = encounter;
+        bc_ = BattleContext();
+        bc_.init(*gc_, encounter);
+        timedOut_ = false;
+        hasReset_ = true;
+        return makeObservation();
+    }
