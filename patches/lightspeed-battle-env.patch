+    template <typename CardContainer>
+    std::vector<int> visiblePileCards(const CardContainer &pile, sts::BattleCardLocation location) {
+        std::vector<std::array<int, kCardFeatureWidth>> rows;
+        rows.reserve(pile.size());
+        for (const auto &card : pile) {
+            switch (card.getId()) {
+                case sts::CardId::BASH:
+                case sts::CardId::DEFEND_RED:
+                case sts::CardId::STRIKE_RED:
+                    break;
+                default:
+                    throw std::runtime_error("unsupported card in the minimal battle pile observation");
+            }
+            // 手牌外费用的公开显示语义尚未核验；0 由 cost_known=false 限定为缺失值。
+            rows.push_back({
+                static_cast<int>(card.getId()),
+                static_cast<int>(location),
+                card.isUpgraded() ? 1 : 0,
+                0,
+                0,
+            });
+        }
+        // 只用公开字段排序，避免把后端实际抽取顺序泄露给 Python 原始观测。
+        std::sort(rows.begin(), rows.end());
+        std::vector<int> cards;
+        cards.reserve(rows.size() * kCardFeatureWidth);
+        for (const auto &row : rows) {
+            cards.insert(cards.end(), row.begin(), row.end());
+        }
+        return cards;
+    }
+
+    sts::BattleIntent visibleIntent(const sts::Monster &monster) {
+        if (!monster.isTargetable()) {
+            return sts::BattleIntent::NONE;
+        }
+        // 类别与现有真实日志对照表一致；虱子和仪式可见性经本地规格仲裁核验。
+        switch (monster.moveHistory[0]) {
+            case sts::MMID::JAW_WORM_CHOMP:
+            case sts::MMID::CULTIST_DARK_STRIKE:
+            case sts::MMID::RED_LOUSE_BITE:
+            case sts::MMID::GREEN_LOUSE_BITE:
+                return sts::BattleIntent::ATTACK;
+            case sts::MMID::JAW_WORM_THRASH:
+                return sts::BattleIntent::ATTACK_DEFEND;
+            case sts::MMID::JAW_WORM_BELLOW:
+                return sts::BattleIntent::DEFEND_BUFF;
+            case sts::MMID::CULTIST_INCANTATION:
+            case sts::MMID::RED_LOUSE_GROW:
+                return sts::BattleIntent::BUFF;
+            case sts::MMID::GREEN_LOUSE_SPIT_WEB:
+                return sts::BattleIntent::DEBUFF;
+            default:
+                throw std::runtime_error("unsupported intent in the minimal battle slice");
+        }
+    }
+
+    int enemyFeature(const sts::Monster &monster, const sts::BattleContext &battle, int offset) {
+        switch (offset) {
+            case 0: return static_cast<int>(monster.id);
+            case 1: return monster.curHp;
+            case 2: return monster.maxHp;
+            case 3: return monster.block;
+            case 4: return monster.strength;
+            case 5: return monster.vulnerable;
+            case 6: return monster.weak;
+            case 7: return static_cast<int>(visibleIntent(monster));
+            case 8: return monster.isTargetable() && monster.isAttacking()
+                ? monster.calculateDamageToPlayer(battle, monster.getMoveBaseDamage(battle).damage) : 0;
+            case 9: return monster.isTargetable() && monster.isAttacking()
+                ? monster.getMoveBaseDamage(battle).attackCount : 0;
+            // 两种状态共用底层存储槽，必须先检查状态是否仍存在。
+            case 10: return monster.hasStatus<sts::MS::CURL_UP>()
+                ? monster.getStatus<sts::MS::CURL_UP>() : 0;
+            case 11: return monster.hasStatus<sts::MS::RITUAL>()
+                ? monster.getStatus<sts::MS::RITUAL>() : 0;
+            default: return 0;
+        }
+    }
+}
