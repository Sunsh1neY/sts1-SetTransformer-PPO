* text=auto
# eval_seeds.json 的 sha256 是跨 run 的可比性锚点（spec-v4 §6.1），必须字节级稳定，禁止任何 EOL 转换
eval_seeds.json -text
# 补丁按上游文本的 LF 保存；空白上下文行的单空格是 unified diff 语法，不作尾空格报错。
*.patch text eol=lf whitespace=-trailing-space

# 历史审计清单绑定实际原始字节，保留已核验的混合换行。
scripts/audit-public-corpus.py -text whitespace=cr-at-eol

# 统一扩展运行指纹必须在不同工作区保持相同换行。
sts/env/ironclad-expansion-contract.json text eol=lf
sts/env/ironclad-registry.json text eol=lf
sts/env/ironclad-capacity.json text eol=lf
sts/env/unified-entity-capacity.json text eol=lf
sts/models/unified-entity-contract.json text eol=lf
sts/models/comparison.py text eol=lf
sts/train/comparison.py text eol=lf

# Preserve audited document-source bytes and migration hashes across checkouts.
archive/** -text whitespace=cr-at-eol,-trailing-space,-blank-at-eof
docs/plans/sts-relic-audit-and-import-plan-v1.md -text whitespace=cr-at-eol,-trailing-space,-blank-at-eof
