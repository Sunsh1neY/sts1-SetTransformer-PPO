+    std::vector<bool> IroncladBattleEnv::makeActionMask() const {
+        std::vector<bool> mask(ACTION_COUNT, false);
+        if (!hasReset_ || terminated() || truncated()) {
+            return mask;
+        }
+        for (int action = 0; action < ACTION_COUNT - 1; ++action) {
+            const int handIdx = action / 3;
+            const int targetIdx = action % 3;
+            if (handIdx >= bc_.cards.cardsInHand ||
+                (!bc_.cards.hand[handIdx].requiresTarget() && targetIdx != 0)) {
+                continue;
+            }
+            const search::Action candidate(search::ActionType::CARD, handIdx, targetIdx);
+            mask[action] = candidate.isValidAction(bc_);
+        }
+        mask[ACTION_COUNT - 1] = search::Action(search::ActionType::END_TURN).isValidAction(bc_);
+        return mask;
+    }
+
+    std::vector<bool> IroncladBattleEnv::actionMask() const {
+        return makeActionMask();
+    }
+
+    BattleObservation IroncladBattleEnv::makeObservation() const {
+        BattleObservation result;
+        result.hand.assign(MAX_HAND * kCardFeatureWidth, 0);
+        result.enemies.assign(MAX_ENEMIES * kEnemyFeatureWidth, 0);
+        result.draw_pile.clear();
+        result.discard_pile.clear();
+        result.exhaust_pile.clear();
+        result.global.assign(kGlobalFeatureWidth, 0);
+        result.hand_mask.assign(MAX_HAND, false);
+        result.enemy_mask.assign(MAX_ENEMIES, false);
+        result.action_mask = makeActionMask();
+
+        if (!hasReset_) {
+            return result;
+        }
+        for (int i = 0; i < bc_.cards.cardsInHand && i < MAX_HAND; ++i) {
+            const auto &card = bc_.cards.hand[i];
+            result.hand[i * kCardFeatureWidth] = static_cast<int>(card.id);
+            result.hand[i * kCardFeatureWidth + 1] = static_cast<int>(BattleCardLocation::HAND);
+            result.hand[i * kCardFeatureWidth + 2] = card.isUpgraded() ? 1 : 0;
+            result.hand[i * kCardFeatureWidth + 3] = card.costForTurn;
+            result.hand[i * kCardFeatureWidth + 4] = 1;
+            result.hand_mask[i] = true;
+        }
+        result.draw_pile = visiblePileCards(bc_.cards.drawPile, BattleCardLocation::DRAW);
+        result.discard_pile = visiblePileCards(bc_.cards.discardPile, BattleCardLocation::DISCARD);
+        result.exhaust_pile = visiblePileCards(bc_.cards.exhaustPile, BattleCardLocation::EXHAUST);
+        int totalEnemyHp = 0;
+        for (int i = 0; i < bc_.monsters.monsterCount && i < MAX_ENEMIES; ++i) {
+            const auto &monster = bc_.monsters.arr[i];
+            result.enemy_mask[i] = monster.isTargetable();
+            for (int j = 0; j < kEnemyFeatureWidth; ++j) {
+                result.enemies[i * kEnemyFeatureWidth + j] = enemyFeature(monster, bc_, j);
+            }
+            totalEnemyHp += std::max(0, monster.curHp);
+        }
+        result.global[0] = bc_.player.curHp;
+        result.global[1] = bc_.player.maxHp;
+        result.global[2] = bc_.player.block;
+        result.global[3] = bc_.player.energy;
+        result.global[4] = bc_.turn;
+        result.global[5] = bc_.cards.cardsInHand;
+        result.global[6] = static_cast<int>(bc_.cards.drawPile.size());
+        result.global[7] = static_cast<int>(bc_.cards.discardPile.size());
+        result.global[8] = static_cast<int>(bc_.cards.exhaustPile.size());
+        result.global[9] = totalEnemyHp;
+        result.global[10] = bc_.player.strength;
+        result.global[11] = bc_.player.getStatus<PS::VULNERABLE>();
+        result.global[12] = bc_.player.getStatus<PS::WEAK>();
+        return result;
+    }
+
+    BattleObservation IroncladBattleEnv::observation() const {
+        return makeObservation();
+    }
+
+    float IroncladBattleEnv::rewardForStep(bool terminal, bool won) const {
+        // D27 battle_reward_v1：过程、失败和硬超时均为0；胜利在全部结算后读取退出HP。
+        if (!terminal) {
+            return 0.0f;
+        }
+        if (bc_.player.maxHp <= 0 || bc_.player.curHp < 0 || bc_.player.curHp > bc_.player.maxHp) {
+            throw std::runtime_error("invalid exit HP for battle_reward_v1");
+        }
+        if (!won) {
+            return 0.0f;
+        }
+        return 1.0f + ALPHA_HP * static_cast<float>(bc_.player.curHp) /
+                                    static_cast<float>(bc_.player.maxHp);
+    }
+
+    bool IroncladBattleEnv::terminated() const {
+        return hasReset_ && bc_.outcome != Outcome::UNDECIDED;
+    }
+
+    bool IroncladBattleEnv::truncated() const {
+        // 硬超时属于任务判负；当前接口没有允许继续自举的外部截断。
+        return false;
+    }
+
+    std::unordered_map<std::string, std::int64_t> IroncladBattleEnv::makeInfo() const {
+        std::unordered_map<std::string, std::int64_t> info;
+        if (!hasReset_) {
+            return info;
+        }
+        info["encounter"] = static_cast<std::int64_t>(bc_.encounter);
+        info["turn"] = bc_.turn;
+        info["player_hp"] = bc_.player.curHp;
+        info["player_max_hp"] = bc_.player.maxHp;
+        info["outcome"] = static_cast<std::int64_t>(bc_.outcome);
+        info["timeout"] = timedOut_ ? 1 : 0;
+        info["ai_rng"] = bc_.aiRng.counter;
+        info["card_random_rng"] = bc_.cardRandomRng.counter;
+        info["misc_rng"] = bc_.miscRng.counter;
+        info["monster_hp_rng"] = bc_.monsterHpRng.counter;
+        info["shuffle_rng"] = bc_.shuffleRng.counter;
+        return info;
+    }
+
+    BattleStepResult IroncladBattleEnv::step(int action) {
+        if (!hasReset_) {
+            throw std::runtime_error("reset must be called before step");
+        }
+        if (action < 0 || action >= ACTION_COUNT) {
+            throw std::out_of_range("action must be in [0, 30]");
+        }
+        if (terminated() || truncated()) {
+            throw std::runtime_error("cannot step a finished battle");
+        }
+        search::Action selected = action == ACTION_COUNT - 1
+            ? search::Action(search::ActionType::END_TURN)
+            : search::Action(search::ActionType::CARD, action / 3, action % 3);
+        if (!makeActionMask()[action]) {
+            throw std::invalid_argument("action is not legal in the current battle state");
+        }
+        selected.execute(bc_);
+        if (bc_.outcome == Outcome::UNDECIDED && bc_.turn >= maxTurns_) {
+            timedOut_ = true;
+            bc_.outcome = Outcome::PLAYER_LOSS;
+        }
+        BattleStepResult result;
+        result.terminated = terminated();
+        result.truncated = truncated();
+        result.reward = rewardForStep(
+            result.terminated,
+            result.terminated && bc_.outcome == Outcome::PLAYER_VICTORY
+        );
+        result.observation = makeObservation();
+        result.info = makeInfo();
+        return result;
+    }
+
