+namespace sts {
+namespace {
+using Json = nlohmann::json;
+
+template <typename C> bool listed(const C &values, const std::string &name) {
+    return std::find_if(values.begin(), values.end(), [&](const char *v) { return name == v; }) != values.end();
+}
+
+std::string sourceCardName(CardId id) {
+    if (id == CardId::STRIKE_RED) return "Strike_R";
+    if (id == CardId::DEFEND_RED) return "Defend_R";
+    if (id == CardId::ASCENDERS_BANE) return "AscendersBane";
+    return cardNames[static_cast<int>(id)];
+}
+
+CardId parseCard(const std::string &name) {
+    for (int i = 1; i < static_cast<int>(CardId::ZAP) + 1; ++i)
+        if (sourceCardName(static_cast<CardId>(i)) == name) return static_cast<CardId>(i);
+    throw std::invalid_argument("未识别卡牌: " + name);
+}
+
+std::string sourcePotionName(Potion p) {
+    switch (p) {
+        case Potion::ESSENCE_OF_STEEL: return "EssenceOfSteel";
+        case Potion::FEAR_POTION: return "FearPotion";
+        case Potion::LIQUID_BRONZE: return "LiquidBronze";
+        case Potion::SPEED_POTION: return "SpeedPotion";
+        case Potion::HEART_OF_IRON: return "HeartOfIron";
+        default: return potionNames[static_cast<int>(p)];
+    }
+}
+
+Potion parsePotion(const std::string &name) {
+    if (!listed(PUBLIC_POTION_NAMES, name)) throw std::invalid_argument("药水不在完整动作闭包内: " + name);
+    for (int i = 2; i <= static_cast<int>(Potion::WEAK_POTION); ++i)
+        if (sourcePotionName(static_cast<Potion>(i)) == name) return static_cast<Potion>(i);
+    throw std::invalid_argument("未识别药水: " + name);
+}
+
+RelicId parseRelic(const std::string &name) {
+    if (!listed(PUBLIC_RELIC_NAMES, name)) throw std::invalid_argument("遗物不在入口闭包内: " + name);
+    if (name == "Burning Blood") return R::BURNING_BLOOD;
+    if (name == "Lantern") return R::LANTERN;
+    if (name == "Anchor") return R::ANCHOR;
+    if (name == "Bag of Preparation") return R::BAG_OF_PREPARATION;
+    if (name == "Vajra") return R::VAJRA;
+    if (name == "Oddly Smooth Stone") return R::ODDLY_SMOOTH_STONE;
+    if (name == "Blood Vial") return R::BLOOD_VIAL;
+    if (name == "Bronze Scales") return R::BRONZE_SCALES;
+    throw std::invalid_argument("未识别遗物: " + name);
+}
+
+int strictInt(const Json &obj, const char *name, int lo, int hi) {
+    const auto &value = obj.at(name);
+    if (!value.is_number_integer()) throw std::invalid_argument(std::string("字段必须为整数: ") + name);
+    const auto n = value.get<std::int64_t>();
+    if (n < lo || n > hi) throw std::invalid_argument(std::string("字段越界: ") + name);
+    return static_cast<int>(n);
+}
+
+std::string visibleIntent(const Monster &m) {
+    if (!m.isTargetable()) return "NONE";
+    switch (m.moveHistory[0]) {
+        case MMID::GENERIC_ESCAPE_MOVE: case MMID::LOOTER_ESCAPE: return "ESCAPE";
+        case MMID::JAW_WORM_THRASH: return "ATTACK_DEFEND";
+        case MMID::JAW_WORM_BELLOW: return "DEFEND_BUFF";
+        case MMID::CULTIST_INCANTATION: case MMID::RED_LOUSE_GROW:
+        case MMID::FUNGI_BEAST_GROW: case MMID::GREMLIN_NOB_BELLOW: return "BUFF";
+        case MMID::ACID_SLIME_L_LICK: case MMID::ACID_SLIME_M_LICK: case MMID::ACID_SLIME_S_LICK:
+        case MMID::SPIKE_SLIME_L_LICK: case MMID::SPIKE_SLIME_M_LICK:
+        case MMID::GREEN_LOUSE_SPIT_WEB: case MMID::RED_SLAVER_ENTANGLE:
+        case MMID::LAGAVULIN_SIPHON_SOUL: case MMID::SENTRY_BOLT: return "DEBUFF";
+        case MMID::BLUE_SLAVER_RAKE: case MMID::RED_SLAVER_SCRAPE:
+        case MMID::FAT_GREMLIN_SMASH: case MMID::GREMLIN_NOB_SKULL_BASH:
+        case MMID::ACID_SLIME_L_CORROSIVE_SPIT: case MMID::ACID_SLIME_M_CORROSIVE_SPIT:
+        case MMID::SPIKE_SLIME_L_FLAME_TACKLE: case MMID::SPIKE_SLIME_M_FLAME_TACKLE: return "ATTACK_DEBUFF";
+        case MMID::SHIELD_GREMLIN_PROTECT: return "DEFEND";
+        case MMID::LOOTER_SMOKE_BOMB: return "DEFEND";
+        case MMID::ACID_SLIME_L_SPLIT: case MMID::SPIKE_SLIME_L_SPLIT: return "UNKNOWN";
+        case MMID::SLIME_BOSS_GOOP_SPRAY: case MMID::THE_GUARDIAN_VENT_STEAM: return "DEBUFF";
+case MMID::SLIME_BOSS_PREPARING: case MMID::SLIME_BOSS_SPLIT: case MMID::HEXAGHOST_ACTIVATE: return "UNKNOWN";
+case MMID::HEXAGHOST_INFLAME: return "DEFEND_BUFF";
+case MMID::HEXAGHOST_SEAR: case MMID::HEXAGHOST_INFERNO: return "ATTACK_DEBUFF";
+case MMID::THE_GUARDIAN_CHARGING_UP: return "DEFEND";
+case MMID::THE_GUARDIAN_DEFENSIVE_MODE: return "BUFF";
+case MMID::SPHERIC_GUARDIAN_ACTIVATE: case MMID::CENTURION_DEFEND: return "DEFEND";
+        case MMID::SPHERIC_GUARDIAN_HARDEN: return "ATTACK_DEFEND";
+        case MMID::MYSTIC_BUFF: case MMID::MYSTIC_HEAL: return "BUFF";
+        case MMID::CHOSEN_HEX: case MMID::SPIRE_GROWTH_CONSTRICT: return "STRONG_DEBUFF";
+        case MMID::CHOSEN_DRAIN: case MMID::SNAKE_PLANT_ENFEEBLING_SPORES: return "DEBUFF";
+        case MMID::SPHERIC_GUARDIAN_ATTACK_DEBUFF: case MMID::SHELLED_PARASITE_FELL:
+        case MMID::CHOSEN_DEBILITATE: case MMID::MYSTIC_ATTACK_DEBUFF:
+        case MMID::TASKMASTER_SCOURING_WHIP: case MMID::ORB_WALKER_LASER: return "ATTACK_DEBUFF";
+        case MMID::SHELLED_PARASITE_STUNNED: return "STUN";
+        case MMID::SHELLED_PARASITE_SUCK: return "ATTACK_BUFF";
+        case MMID::LAGAVULIN_SLEEP: return "SLEEP";
+        case MMID::GREMLIN_WIZARD_CHARGING: return "UNKNOWN";
+        case MMID::SNECKO_PERPLEXING_GLARE: return "STRONG_DEBUFF";
+        case MMID::SNECKO_TAIL_WHIP: return "ATTACK_DEBUFF";
+        case MMID::BYRD_CAW: return "BUFF";
+        case MMID::BYRD_FLY: case MMID::ROMEO_MOCK: case MMID::GREMLIN_LEADER_RALLY:
+        case MMID::THE_COLLECTOR_SPAWN: case MMID::BRONZE_AUTOMATON_SPAWN_ORBS: return "UNKNOWN";
+        case MMID::BYRD_STUNNED: case MMID::BRONZE_AUTOMATON_STUNNED: return "STUN";
+        case MMID::MUGGER_ESCAPE: return "ESCAPE";
+        case MMID::MUGGER_SMOKE_BOMB: case MMID::BRONZE_ORB_SUPPORT_BEAM: return "DEFEND";
+        case MMID::BEAR_BEAR_HUG: return "STRONG_DEBUFF";
+        case MMID::BEAR_LUNGE: return "ATTACK_DEFEND";
+        case MMID::ROMEO_AGONIZING_SLASH: case MMID::THE_CHAMP_FACE_SLAP: return "ATTACK_DEBUFF";
+        case MMID::GREMLIN_LEADER_ENCOURAGE: case MMID::THE_COLLECTOR_BUFF:
+        case MMID::THE_CHAMP_DEFENSIVE_STANCE: case MMID::BRONZE_AUTOMATON_BOOST: return "DEFEND_BUFF";
+        case MMID::THE_COLLECTOR_MEGA_DEBUFF: case MMID::BRONZE_ORB_STASIS: return "STRONG_DEBUFF";
+        case MMID::THE_CHAMP_TAUNT: return "DEBUFF";
+        case MMID::THE_CHAMP_GLOAT: case MMID::THE_CHAMP_ANGER: return "BUFF";
+        case MMID::THE_MAW_ROAR: return "DEBUFF";
+        case MMID::THE_MAW_DROOL: return "BUFF";
+        default:
+            if (isMoveAttack(m.moveHistory[0])) return "ATTACK";
+            throw std::runtime_error("未映射可见意图，拒绝不完整观测");
+    }
+}
+
+Json monsterStatuses(const Monster &m) {
+    Json ret = Json::object();
+#define EP_MONSTER_STATUS(x) if (m.hasStatus<MS::x>()) ret[enemyStatusStrings[static_cast<int>(MS::x)]] = m.getStatus<MS::x>();
+    EP_MONSTER_STATUS(ARTIFACT)
+    // 敌方Strength单独存储，buff不会设置statusBits，负值同样可见。
+    if (m.strength != 0) ret["Strength"] = m.strength;
+    EP_MONSTER_STATUS(VULNERABLE)
+    EP_MONSTER_STATUS(WEAK)
+    EP_MONSTER_STATUS(METALLICIZE)
+    EP_MONSTER_STATUS(REGEN)
+    EP_MONSTER_STATUS(ANGRY)
+    EP_MONSTER_STATUS(CURL_UP)
+    EP_MONSTER_STATUS(ENRAGE)
+    EP_MONSTER_STATUS(RITUAL)
+    EP_MONSTER_STATUS(SPORE_CLOUD)
+    EP_MONSTER_STATUS(THIEVERY)
+    EP_MONSTER_STATUS(MODE_SHIFT)
+    EP_MONSTER_STATUS(SHARP_HIDE)
+    EP_MONSTER_STATUS(PLATED_ARMOR)
+    EP_MONSTER_STATUS(MALLEABLE)
+    EP_MONSTER_STATUS(GENERIC_STRENGTH_UP)
+    // 用户批准的公开状态；保留状态存在且计数为0的情况（例如Slow）。
+    EP_MONSTER_STATUS(FLIGHT)
+    EP_MONSTER_STATUS(THORNS)
+    EP_MONSTER_STATUS(SLOW)
+    EP_MONSTER_STATUS(INTANGIBLE)
+    EP_MONSTER_STATUS(FADING)
+    EP_MONSTER_STATUS(REACTIVE)
+    EP_MONSTER_STATUS(TIME_WARP)
+    if (m.hasStatus<MS::SHIFTING>()) ret["Shifting"] = 1;
+    if (m.hasStatus<MS::BARRICADE>()) ret["Barricade"] = 1;
+    if (m.hasStatus<MS::ASLEEP>()) ret["Asleep"] = 1;
+#undef EP_MONSTER_STATUS
+    return ret;
+}
+
+int potionPotency(Potion p) {
+    switch (p) {
+        case Potion::WEAK_POTION: case Potion::FEAR_POTION: case Potion::LIQUID_BRONZE: case Potion::SWIFT_POTION: return 3;
+        case Potion::REGEN_POTION: case Potion::SPEED_POTION: case Potion::FRUIT_JUICE: return 5;
+        case Potion::ESSENCE_OF_STEEL: return 4;
+        case Potion::EXPLOSIVE_POTION: return 10;
+        case Potion::ANCIENT_POTION: return 1;
+        case Potion::ENERGY_POTION: case Potion::DEXTERITY_POTION: case Potion::STRENGTH_POTION: return 2;
+        case Potion::HEART_OF_IRON: return 6;
+        case Potion::BLOCK_POTION: return 12;
+        default: throw std::runtime_error("未注册药水效力");
+    }
+}
+
+class PublicBattleEnv {
+    struct PublicEnemyHistory {
+        std::string name;
+        std::string lastIntent = "NONE";
+        std::string previousIntent = "NONE";
+        int completedTurns = 0;
+        int chargeTurns = 0;
+        int sleepTurns = 0;
+    };
+    std::unique_ptr<GameContext> gc_;
+    BattleContext bc_;
+    int maxActions_;
+    bool expanded_ = false;
+    int actionCount_ = 0;
+    int initialCards_ = 0;
+    bool hasReset_ = false;
+    bool truncated_ = false;
+    std::vector<std::string> relicNames_;
+    std::array<PublicEnemyHistory, PUBLIC_TARGET_CAPACITY> publicHistory_{};
+
+    bool terminal() const { return hasReset_ && bc_.outcome != Outcome::UNDECIDED; }
+
+    Json cardRow(const CardInstance &c, bool inHand) const {
+        const bool up = c.isUpgraded();
+        int damage = 0, block = 0, magic = 0, hits = 1;
+        bool all = false;
+        switch (c.id) {
+            case CardId::CLASH: damage = up ? 18 : 14; break;
+            case CardId::HEMOKINESIS: damage = up ? 20 : 15; magic = 2; break;
+            case CardId::BLOODLETTING: magic = up ? 3 : 2; break;
+            case CardId::INTIMIDATE: magic = up ? 2 : 1; all = true; break;
+            case CardId::LIMIT_BREAK: magic = 2; break;
+            case CardId::OFFERING: magic = up ? 5 : 3; break;
+            case CardId::SHOCKWAVE: magic = up ? 5 : 3; all = true; break;
+            case CardId::FEED: damage = up ? 12 : 10; magic = up ? 4 : 3; break;
+            case CardId::REAPER: damage = up ? 5 : 4; all = true; break;
+            case CardId::SWORD_BOOMERANG: damage = 3; hits = up ? 4 : 3; break;
+            case CardId::SECOND_WIND: block = up ? 7 : 5; break;
+            case CardId::SEVER_SOUL: damage = up ? 22 : 16; break;
+            case CardId::BERSERK: magic = up ? 1 : 2; break;
+            case CardId::BRUTALITY: case CardId::DARK_EMBRACE: magic = 1; break;
+            case CardId::EVOLVE: case CardId::RUPTURE: magic = up ? 2 : 1; break;
+            case CardId::FIRE_BREATHING: magic = up ? 10 : 6; break;
+            case CardId::JUGGERNAUT: magic = up ? 7 : 5; break;
+            case CardId::ARMAMENTS: block = 5; break;
+            case CardId::BURNING_PACT: magic = up ? 3 : 2; break;
+            case CardId::DUAL_WIELD: magic = up ? 2 : 1; break;
+            case CardId::EXHUME: magic = 1; break;
+            case CardId::HEADBUTT: damage = up ? 12 : 9; break;
+            case CardId::WARCRY: magic = up ? 2 : 1; break;
+            case CardId::ANGER: damage = up ? 8 : 6; magic = 1; break;
+            case CardId::PERFECTED_STRIKE: damage = 6 + bc_.cards.strikeCount * (up ? 3 : 2); magic = up ? 3 : 2; break;
+            case CardId::SEARING_BLOW: damage = c.getUpgradeCount() * (c.getUpgradeCount()+7) / 2 + 12; break;
+            case CardId::WHIRLWIND: damage = up ? 8 : 5; all = true; break;
+            case CardId::DISARM: magic = up ? 3 : 2; break;
+            case CardId::IRON_WAVE: damage = block = up ? 7 : 5; break;
+            case CardId::FIEND_FIRE: damage = up ? 10 : 7; break;
+            case CardId::DOUBLE_TAP: magic = up ? 2 : 1; break;
+            case CardId::HAVOC: case CardId::INFERNAL_BLADE: magic = 1; break;
+            case CardId::RAMPAGE: damage = 8 + c.specialData; magic = up ? 8 : 5; break;
+            case CardId::BLOOD_FOR_BLOOD: damage = up ? 22 : 18; break;
+            case CardId::BARRICADE: case CardId::CORRUPTION: magic = 1; break;
+            case CardId::COMBUST: magic = up ? 7 : 5; break;
+            case CardId::STRIKE_RED: damage = up ? 9 : 6; break;
+            case CardId::DEFEND_RED: block = up ? 8 : 5; break;
+            case CardId::BASH: damage = up ? 10 : 8; magic = up ? 3 : 2; break;
+            case CardId::BLUDGEON: damage = up ? 42 : 32; break;
+            case CardId::CLEAVE: damage = up ? 11 : 8; all = true; break;
+            case CardId::CLOTHESLINE: damage = up ? 14 : 12; magic = up ? 3 : 2; break;
+            case CardId::TWIN_STRIKE: damage = up ? 7 : 5; hits = 2; break;
+            case CardId::THUNDERCLAP: damage = up ? 7 : 4; magic = 1; all = true; break;
+            case CardId::UPPERCUT: damage = 13; magic = up ? 2 : 1; break;
+            case CardId::BODY_SLAM: damage = bc_.player.block; break;
+            case CardId::ENTRENCH: block = bc_.player.block; break;
+            case CardId::HEAVY_BLADE: damage = 14; magic = up ? 5 : 3; break;
+            case CardId::SPOT_WEAKNESS: magic = up ? 4 : 3; break;
+            case CardId::INFLAME: magic = up ? 3 : 2; break;
+            case CardId::POMMEL_STRIKE: damage = up ? 10 : 9; magic = up ? 2 : 1; break;
+            case CardId::SHRUG_IT_OFF: block = up ? 11 : 8; magic = 1; break;
+            case CardId::DROPKICK: damage = up ? 8 : 5; magic = 1; break;
+            case CardId::CARNAGE: damage = up ? 28 : 20; break;
+            case CardId::GHOSTLY_ARMOR: block = up ? 13 : 10; break;
+            case CardId::IMPERVIOUS: block = up ? 40 : 30; break;
+            case CardId::PUMMEL: damage = 2; hits = up ? 5 : 4; break;
+            case CardId::SEEING_RED: magic = 2; break;
+            case CardId::SENTINEL: block = up ? 8 : 5; magic = up ? 3 : 2; break;
+            case CardId::TRUE_GRIT: block = up ? 9 : 7; magic = 1; break;
+            case CardId::BATTLE_TRANCE: magic = up ? 4 : 3; break;
+            case CardId::FLEX: magic = up ? 4 : 2; break;
+            case CardId::METALLICIZE: magic = up ? 4 : 3; break;
+            case CardId::DEMON_FORM: magic = up ? 3 : 2; break;
+            case CardId::RAGE: magic = up ? 5 : 3; break;
+            case CardId::FLAME_BARRIER: block = up ? 16 : 12; magic = up ? 6 : 4; break;
+            case CardId::FEEL_NO_PAIN: magic = up ? 4 : 3; break;
+            case CardId::WILD_STRIKE: damage = up ? 17 : 12; magic = 1; break;
+            case CardId::RECKLESS_CHARGE: damage = up ? 10 : 7; magic = 1; break;
+            case CardId::POWER_THROUGH: block = up ? 20 : 15; magic = 2; break;
+            case CardId::IMMOLATE: damage = up ? 28 : 21; magic = 1; all = true; break;
+            case CardId::BURN: magic = up ? 4 : 2; break;
+            case CardId::ASCENDERS_BANE: case CardId::WOUND: case CardId::DAZED: case CardId::SLIMED: break;
+            default: throw std::runtime_error("生成了注册表之外的卡，拒绝观测");
+        }
+        Json damages = Json::array();
+        for (int target = 0; target < PUBLIC_TARGET_CAPACITY; ++target) {
+            int value = 0;
+            if (c.getType() == CardType::ATTACK && bc_.monsters.arr[target].isTargetable()) {
+                int base = damage;
+                if (c.id == CardId::HEAVY_BLADE) base += (up ? 4 : 2) * bc_.player.strength;
+                value = bc_.calculateCardDamage(c, target, base);
+            }
+            damages.push_back(value);
+        }
+        const int resolvedBlock = c.id == CardId::ENTRENCH ? block : (block > 0 ? bc_.calculateCardBlock(block) : 0);
+        // 非手牌费用保留缺失标记；牌序只按下面公开字段排序。
+        Json row = {{"name", sourceCardName(c.id)}, {"card_id", static_cast<int>(c.id)},
+            {"upgrade_count", c.getUpgradeCount()}, {"cost", inHand ? c.costForTurn : 0}, {"cost_known", inHand},
+            {"base_cost", c.cost}, {"target_kind", c.requiresTarget() ? "ENEMY" : "NO_TARGET"},
+            {"damage", damage}, {"block", resolvedBlock}, {"base_block", block}, {"magic", magic},
+            {"hits", hits}, {"damage_by_target", damages}, {"all_enemies", all},
+            {"card_type", cardTypeStrings[static_cast<int>(c.getType())]},
+            {"exhaust", c.doesExhaust()}, {"ethereal", c.isEthereal()},
+            {"free_to_play_once", c.freeToPlayOnce}, {"retain", c.retain}};
+        if (expanded_) {
+            // 只输出具名公开属性，不输出specialData或实例ID。
+            const bool corruption = c.getType() == CardType::SKILL && bc_.player.hasStatus<PS::CORRUPTION>();
+            if (c.uniqueId == bc_.cards.knownTopId && !inHand) row["known_top"] = true;
+            if (!inHand && c.costForTurn != c.cost) row["recovery_cost"] = c.costForTurn;
+            row["printed_cost"] = getEnergyCost(c.id, up);
+            row["effective_cost_known"] = inHand;
+            row["effective_cost"] = inHand ? (corruption || c.isFreeToPlay(bc_) ? 0 : std::max(0, static_cast<int>(c.costForTurn))) : 0;
+            row["cost_scope"] = !inHand ? "UNKNOWN" : corruption ? "POWER" : c.freeToPlayOnce ? "ONCE" :
+                c.costForTurn != c.cost ? "TURN" : "COMBAT";
+            row["combat_damage_bonus"] = c.id == CardId::RAMPAGE ? c.specialData : 0;
+            row["is_strike"] = c.isStrikeCard();
+            row["cost_kind"] = c.isXCost() ? "X" : c.cost < 0 ? "UNPLAYABLE" : "ENERGY";
+            row["effective_exhaust"] = c.doesExhaust() ||
+                (c.getType() == CardType::SKILL && bc_.player.hasStatus<PS::CORRUPTION>());
+        }
+        return row;
+    }
+
+    template <typename C> Json pileRows(const C &pile) const {
+        std::vector<Json> rows;
+        for (const auto &card : pile) rows.push_back(cardRow(card, false));
+        std::sort(rows.begin(), rows.end(), [](const Json &a, const Json &b) { return a.dump() < b.dump(); });
+        return rows;
+    }
+
+    bool supportedSelection() const {
+        switch (bc_.cardSelectInfo.cardSelectTask) {
+            case CardSelectTask::ARMAMENTS: case CardSelectTask::DUAL_WIELD:
+            case CardSelectTask::EXHAUST_ONE: case CardSelectTask::EXHUME:
+            case CardSelectTask::HEADBUTT: case CardSelectTask::WARCRY: return true;
+            default: return false;
+        }
+    }
+
+    Json resolutionContext() const {
+        if (bc_.inputState != InputState::CARD_SELECT) return Json::object();
+        const auto &item = bc_.curCardQueueItem;
+        int pendingReplayCount = 0;
+        for (int i = 0; i < bc_.cardQueue.size; ++i) {
+            const int index = (bc_.cardQueue.frontIdx + i) % CardQueue::capacity;
+            if (bc_.cardQueue.arr[index].purgeOnUse) ++pendingReplayCount;
+        }
+        const char *sourceMode = item.purgeOnUse ? "REPLAY" : item.autoplay ? "AUTOPLAY" : "MANUAL";
+        return {{"source_mode", sourceMode},
+                {"source_will_exhaust", item.exhaustOnUse || item.card.doesExhaust()},
+                {"pending_replay_count", pendingReplayCount}};
+    }
+
+    void verifyDecision() const {
+        if (bc_.undefinedBehaviorEvoked) throw std::runtime_error("后端标记未定义行为");
+        if (!terminal() && bc_.inputState != InputState::PLAYER_NORMAL &&
+            !(expanded_ && bc_.inputState == InputState::CARD_SELECT && supportedSelection()))
+            throw std::runtime_error("出现未支持的二次选择或未结算队列");
+        if (bc_.monsters.monsterCount > PUBLIC_TARGET_CAPACITY || bc_.cards.cardsInHand > PUBLIC_HAND_CAPACITY)
+            throw std::runtime_error("后端实体数超出动作容量");
+        // 白名单中每个玩家动作最多生成2张；一次结束回合5敌各至多3张。
+        if (!expanded_ && bc_.cards.nextUniqueCardId > initialCards_ + PUBLIC_GENERATED_PER_ACTION * actionCount_)
+            throw std::runtime_error("生成量超出已证明边界");
+    }
+
+    Json observeJson() const {
+        if (!hasReset_) throw std::runtime_error("必须先reset_scene");
+        verifyDecision();
+        Json hand = Json::array(), enemies = Json::array(), potions = Json::array(), relics = Json::array();
+        for (int i = 0; i < bc_.cards.cardsInHand; ++i) hand.push_back(cardRow(bc_.cards.hand[i], true));
+        Json statuses = Json::object();
+        for (int i = 1; i < static_cast<int>(PS::THE_BOMB); ++i) {
+            const auto id = static_cast<PS>(i);
+            if (!bc_.player.hasStatusRuntime(id)) continue;
+            // 当前白名单的布尔状态NoDraw/Entangled不依赖statusMap。
+            if (id == PS::NO_DRAW || id == PS::ENTANGLED || id == PS::HEX ||
+                (expanded_ && (id == PS::BARRICADE || id == PS::CORRUPTION || id == PS::CONFUSED))) statuses[playerStatusStrings[i]] = 1;
+            else statuses[playerStatusStrings[i]] = bc_.player.getStatusRuntime(id);
+        }
+        Json player = {{"hp", bc_.player.curHp}, {"max_hp", bc_.player.maxHp}, {"block", bc_.player.block},
+            {"energy", bc_.player.energy}, {"energy_per_turn", bc_.player.energyPerTurn},
+            {"turn", bc_.turn}, {"ascension", bc_.ascension}, {"statuses", statuses},
+            {"cards_played_this_turn", bc_.player.cardsPlayedThisTurn},
+            {"attacks_played_this_turn", bc_.player.attacksPlayedThisTurn},
+            {"skills_played_this_turn", bc_.player.skillsPlayedThisTurn}};
+        for (int i = 0; i < PUBLIC_TARGET_CAPACITY; ++i) {
+            const auto &m = bc_.monsters.arr[i];
+            const bool present = !terminal() && i < bc_.monsters.monsterCount && (m.isTargetable() || m.halfDead);
+            const bool targetable = present && m.isTargetable();
+            const bool attack = targetable && isMoveAttack(m.moveHistory[0]);
+            const auto damage = attack ? m.getMoveBaseDamage(bc_) : DamageInfo{};
+            const auto &history = publicHistory_[i];
+            const Json publicHistory = {{"completed_enemy_turns", history.completedTurns},
+                {"charge_turns_observed", history.chargeTurns}, {"sleep_turns_observed", history.sleepTurns}};
+            enemies.push_back({{"present", present}, {"targetable", targetable},
+                {"name", present ? monsterIdStrings[static_cast<int>(m.id)] : ""},
+                {"hp", present ? m.curHp : 0}, {"max_hp", present ? m.maxHp : 0}, {"block", present ? m.block : 0},
+                {"intent_kind", targetable ? visibleIntent(m) : "NONE"},
+                {"intent_damage", attack ? m.calculateDamageToPlayer(bc_, damage.damage) : 0},
+                {"intent_hits", attack ? damage.attackCount : 0}, {"statuses", present ? monsterStatuses(m) : Json::object()},
+                {"public_history", publicHistory}, {"phase", present && m.publicPhase == 1 ? "PHASE_1" : present && m.publicPhase == 2 ? "PHASE_2" : "NONE"},
+                {"intent_history", Json::array({present ? static_cast<int>(m.moveHistory[0]) : 0, present ? static_cast<int>(m.moveHistory[1]) : 0, present ? static_cast<int>(m.moveHistory[2]) : 0})},
+                {"intent_history_valid", Json::array({present && m.moveHistory[0] != MMID::INVALID, present && m.moveHistory[1] != MMID::INVALID, present && m.moveHistory[2] != MMID::INVALID})}});
+        }
+        for (int i = 0; i < PUBLIC_POTION_CAPACITY; ++i) {
+            const auto p = bc_.potions[i];
+            const bool present = i < bc_.potionCapacity && p != Potion::EMPTY_POTION_SLOT && p != Potion::INVALID;
+            potions.push_back({{"present", present}, {"name", present ? sourcePotionName(p) : ""},
+                {"potency", present ? potionPotency(p) : 0}, {"target_kind", present && potionRequiresTarget(p) ? "ENEMY" : "NO_TARGET"}});
+        }
+        for (const auto &r : relicNames_) relics.push_back({{"name", r}, {"counter", nullptr}});
+        Json result = {{"schema", "public-observation-v1"}, {"hand", hand}, {"draw_pile", pileRows(bc_.cards.drawPile)},
+            {"discard_pile", pileRows(bc_.cards.discardPile)}, {"exhaust_pile", pileRows(bc_.cards.exhaustPile)},
+            {"player", player}, {"enemies", enemies}, {"potions", potions}, {"potion_capacity", bc_.potionCapacity},
+            {"relics", relics}, {"action_mask", actionMask()}};
+        if (expanded_) {
+            result["schema"] = IRONCLAD_OBSERVATION_SCHEMA;
+            result["stasis"] = Json::array();
+            result["relations"] = Json::array();
+            Json enemyRefs = Json::array(), cardRefs = Json::array();
+            for (int i = 0; i < PUBLIC_TARGET_CAPACITY; ++i) {
+                const auto &m = bc_.monsters.arr[i];
+                const bool present = enemies[i]["present"].get<bool>();
+                const auto ref = std::string("enemy:") + std::to_string(m.entitySerial);
+                enemyRefs.push_back(present ? Json(ref) : Json(nullptr));
+                if (present && m.id == MonsterId::BRONZE_ORB && m.hasStatus<MS::STASIS>()) {
+                    const auto &card = bc_.cards.stasisCards[std::min(i, 1)];
+                    if (card.id == CardId::INVALID) throw std::runtime_error("持牌关系缺失卡实例");
+                    const auto cardRef = std::string("card:") + std::to_string(card.uniqueId);
+                    // 仅公开牌名；升级与实例动态属性不从后端真值泄露。
+                    result["stasis"].push_back({{"name", sourceCardName(card.id)}});
+                    cardRefs.push_back(cardRef);
+                    result["relations"].push_back({{"kind", "holds_card"}, {"enemy_ref", ref}, {"card_ref", cardRef}});
+                }
+            }
+            result["routing"] = {{"enemy_refs", enemyRefs}, {"stasis_refs", cardRefs}};
+            result["resolving"] = Json::array();
+            if (!terminal() && bc_.inputState == InputState::CARD_SELECT) {
+                // 仅当前已公开的来源卡；不导出整个动作队列或隐藏实例ID。
+                result["resolving"].push_back(cardRow(bc_.curCardQueueItem.card, false));
+            }
+            result["player"]["combust_hp_loss"] = bc_.player.combustHpLoss;
+            result["decision"] = {{"phase", "NORMAL"}, {"selection", nullptr}};
+            if (!terminal() && bc_.inputState == InputState::CARD_SELECT)
+                result["decision"] = {{"phase", "SELECT_CARD"}, {"selection", {{"kind", cardSelectTaskStrings[static_cast<int>(bc_.cardSelectInfo.cardSelectTask)]}}},
+                    {"resolution_context", resolutionContext()}};
+        }
+        return result;
+    }
+
+public:
+    explicit PublicBattleEnv(int maxActions = PUBLIC_MAX_ACTIONS, bool expanded = false) : maxActions_(maxActions), expanded_(expanded) {
+        if (maxActions < 1 || maxActions > PUBLIC_MAX_ACTIONS) throw std::invalid_argument("max_actions必须在1..512");
+        static_assert(PUBLIC_MAX_INITIAL_CARDS + PUBLIC_MAX_ACTIONS * PUBLIC_GENERATED_PER_ACTION < 32767,
+                      "生成牌ID必须保持int16范围");
+    }
+
+    std::string resetScene(const std::string &encoded, std::uint64_t seed) {
+        hasReset_ = false;
+        const auto scene = Json::parse(encoded);
+        if (scene.at("entry_timing") != "pre_combat_initialization" || scene.at("initialization_phase") != "before_destination_room_entry")
+            throw std::invalid_argument("只支持明确的入口A");
+        if (scene.contains("character") && scene.at("character") != "IRONCLAD") throw std::invalid_argument("只支持Ironclad");
+        const int ascension = strictInt(scene, "ascension", 0, 20);
+        const int floor = strictInt(scene, "floor", 1, 51);
+        const auto encounterName = scene.at("encounter").get<std::string>();
+        if (!listed(IRONCLAD_ENCOUNTER_NAMES, encounterName)) throw std::invalid_argument("遭遇不在白名单");
+        MonsterEncounter encounter = ME::INVALID;
+        for (int i = 1; i <= static_cast<int>(ME::MYSTERIOUS_SPHERE_EVENT); ++i)
+            if (encounterName == monsterEncounterEnumNames[i]) encounter = static_cast<ME>(i);
+        if (encounter == ME::INVALID) throw std::invalid_argument("遭遇映射失败");
+        const bool elite = encounter == ME::GREMLIN_NOB || encounter == ME::LAGAVULIN || encounter == ME::THREE_SENTRIES || encounter == ME::SLAVERS || encounter == ME::GREMLIN_LEADER || encounter == ME::BOOK_OF_STABBING;
+        if (elite && (!scene.contains("burning_elite") || !scene.at("burning_elite").is_boolean()))
+            throw std::invalid_argument("精英必须显式给出燃烧强化条件");
+        if (scene.value("burning_elite", false)) throw std::invalid_argument("燃烧强化尚未验收，拒绝整场");
+        const auto &p = scene.at("player");
+        const int maxHp = strictInt(p, "max_hp", 1, 32767);
+        const int hp = strictInt(p, "hp", 1, maxHp);
+        const int gold = strictInt(p, "gold", 0, 32767);
+        gc_ = std::make_unique<GameContext>(CharacterClass::IRONCLAD, seed, ascension);
+        const int expectedAct = (encounter == ME::MAW || encounter == ME::TRANSIENT) ? 3 : ((encounter >= ME::SPHERIC_GUARDIAN && encounter <= ME::CHAMP) || encounter == ME::COLOSSEUM_EVENT_SLAVERS || encounter == ME::COLOSSEUM_EVENT_NOBS || encounter == ME::MASKED_BANDITS_EVENT) ? 2 : 1;
+        if (strictInt(scene, "act", 1, 3) != expectedAct || floor < 1 + (expectedAct-1)*17 || floor > expectedAct*17)
+            throw std::invalid_argument("幕、楼层与集成遭遇不一致");
+        gc_->act = expectedAct;
+        gc_->floorNum = floor;
+        gc_->curRoom = (encounter == ME::AUTOMATON || encounter == ME::COLLECTOR || encounter == ME::CHAMP) ? Room::BOSS : elite ? Room::ELITE : Room::MONSTER;
+        gc_->info.encounter = encounter;
+        gc_->regainControlAction = [](GameContext &) {}; // 单场出口，不进入地图或下一场
+        // 不使用随机地图上的燃烧坐标假装真实入口条件。
+        gc_->curMapNodeX = -2;
+        gc_->curMapNodeY = -2;
+        gc_->curHp = hp; gc_->maxHp = maxHp; gc_->gold = gold;
+        const auto &deck = scene.at("deck");
+        if (!deck.is_array() || deck.empty() || deck.size() > PUBLIC_MAX_INITIAL_CARDS) throw std::invalid_argument("入口牌组容量无效");
+        gc_->deck = Deck{};
+        for (const auto &value : deck) {
+            auto name = value.get<std::string>();
+            int upgrade = 0;
+            const auto plus = name.find('+');
+            if (plus != std::string::npos) {
+                const auto suffix = name.substr(plus + 1);
+                if (expanded_ && name.substr(0, plus) == "Searing Blow") {
+                    if (suffix.empty() || suffix.size() > 3 || suffix.find_first_not_of("0123456789") != std::string::npos)
+                        throw std::invalid_argument("非法升级次数");
+                    upgrade = std::stoi(suffix);
+                    if (upgrade < 1 || upgrade > 100 || std::to_string(upgrade) != suffix) throw std::invalid_argument("Searing Blow支持+1至+100");
+                } else {
+                    if (suffix != "1") throw std::invalid_argument("未支持重复升级或模糊升级");
+                    upgrade = 1;
+                }
+                name.resize(plus);
+            }
+            if (!(expanded_ ? listed(IRONCLAD_CARD_NAMES, name) : listed(PUBLIC_CARD_NAMES, name))) throw std::invalid_argument("卡牌不在完整闭包: " + name);
+            const auto id = parseCard(name);
+            if (upgrade && ((id == CardId::TRUE_GRIT && !expanded_) || id == CardId::ASCENDERS_BANE || id == CardId::WOUND || id == CardId::DAZED || id == CardId::BURN || id == CardId::SLIMED))
+                throw std::invalid_argument("该卡升级路径不支持");
+            Card entry(id, upgrade);
+            if (id == CardId::SEARING_BLOW) entry.misc = upgrade;
+            gc_->deck.obtainRaw(entry);
+        }
+        initialCards_ = gc_->deck.size();
+        relicNames_.clear();
+        gc_->relics = RelicContainer{};
+        if (!scene.at("relics").is_array()) throw std::invalid_argument("遗物必须为完整列表");
+        for (const auto &value : scene.at("relics")) {
+            auto name = value.get<std::string>();
+            if (std::find(relicNames_.begin(), relicNames_.end(), name) != relicNames_.end()) throw std::invalid_argument("重复遗物");
+            gc_->relics.add({parseRelic(name), 0}); relicNames_.push_back(name);
+        }
+        gc_->potionCapacity = ascension >= 11 ? 2 : 3;
+        gc_->potionCount = 0;
+        std::fill(gc_->potions.begin(), gc_->potions.end(), Potion::EMPTY_POTION_SLOT);
+        const auto &pots = scene.at("potions");
+        if (!pots.is_array() || pots.size() != static_cast<std::size_t>(gc_->potionCapacity)) throw std::invalid_argument("药水库存槽数与进阶不一致");
+        for (int i = 0; i < gc_->potionCapacity; ++i) if (!pots[i].is_null()) {
+            gc_->potions[i] = parsePotion(pots[i].get<std::string>()); ++gc_->potionCount;
+        }
+        // 这8种遗物无目的普通/精英房间独立入口效果；BattleContext执行其开战效果一次。
+        bc_ = BattleContext{};
+        bc_.enemyPotionExpansion = true;
+        bc_.actionQueue.checkedCapacity = true;
+        bc_.cardQueue.checkedCapacity = true;
+        bc_.init(*gc_, encounter);
+        bc_.player.cc = CharacterClass::IRONCLAD;
+        publicHistory_ = {};
+        for (int i = 0; i < bc_.monsters.monsterCount; ++i)
+            publicHistory_[i].name = monsterIdStrings[static_cast<int>(bc_.monsters.arr[i].id)];
+        actionCount_ = 0; truncated_ = false; hasReset_ = true;
+        return observeJson().dump();
+    }
+
+    std::vector<bool> actionMask() const {
+        std::vector<bool> mask(PUBLIC_ACTION_COUNT, false);
+        // 外部截断的最终观测仍保留原MDP合法动作，供价值自举。
+        if (!hasReset_ || terminal()) return mask;
+        for (int h = 0; h < bc_.cards.cardsInHand; ++h) for (int t = 0; t < PUBLIC_TARGET_CAPACITY; ++t) {
+            if (!bc_.cards.hand[h].requiresTarget() && t != 0) continue;
+            mask[h * PUBLIC_TARGET_CAPACITY + t] = search::Action(search::ActionType::CARD, h, t).isValidAction(bc_);
+        }
+        mask[PUBLIC_END_TURN] = search::Action(search::ActionType::END_TURN).isValidAction(bc_);
+        for (int p = 0; p < bc_.potionCapacity; ++p) for (int t = 0; t < PUBLIC_TARGET_CAPACITY; ++t) {
+            if (!potionRequiresTarget(bc_.potions[p]) && t != 0) continue;
+            mask[PUBLIC_END_TURN + 1 + p * PUBLIC_TARGET_CAPACITY + t] = search::Action(search::ActionType::POTION, p, t).isValidAction(bc_);
+        }
+        return mask;
+    }
+
+    // 仅供采集资源计数与info，不进入模型公开观测。
+    int allocationCount() const {
+        if (!hasReset_) throw std::runtime_error("必须先reset_scene");
+        return bc_.cards.nextUniqueCardId;
+    }
+    std::string observation() const { return observeJson().dump(); }
+
+    std::string step(int action) {
+        if (!hasReset_ || terminal() || truncated_) throw std::runtime_error("不允许在未开始或已结束场景step");
+        if (action < 0 || action >= PUBLIC_ACTION_COUNT || !actionMask()[action]) throw std::invalid_argument("非法动作");
+        search::Action selected;
+        if (action < PUBLIC_END_TURN) selected = search::Action(search::ActionType::CARD, action / PUBLIC_TARGET_CAPACITY, action % PUBLIC_TARGET_CAPACITY);
+        else if (action == PUBLIC_END_TURN) selected = search::Action(search::ActionType::END_TURN);
+        else { const int a = action - PUBLIC_END_TURN - 1; selected = search::Action(search::ActionType::POTION, a / PUBLIC_TARGET_CAPACITY, a % PUBLIC_TARGET_CAPACITY); }
+        return executeDecision(selected, action);
+    }
+
+    std::vector<int> selectionIndices() const {
+        if (!expanded_ || terminal() || bc_.inputState != InputState::CARD_SELECT ||
+            !supportedSelection())
+            throw std::runtime_error("不是受支持的选牌暂停点");
+        std::vector<int> indices;
+        const auto task = bc_.cardSelectInfo.cardSelectTask;
+        const int size = task == CardSelectTask::HEADBUTT ? bc_.cards.discardPile.size() :
+            task == CardSelectTask::EXHUME ? bc_.cards.exhaustPile.size() : bc_.cards.cardsInHand;
+        for (int i = 0; i < size; ++i)
+            if (search::Action(search::ActionType::SINGLE_CARD_SELECT, i).isValidAction(bc_)) indices.push_back(i);
+        return indices;
+    }
+
+    std::string selectionCard(int index) const {
+        const auto indices = selectionIndices();
+        if (std::find(indices.begin(), indices.end(), index) == indices.end()) throw std::invalid_argument("非法候选");
+        const auto task = bc_.cardSelectInfo.cardSelectTask;
+        if (task == CardSelectTask::HEADBUTT) return cardRow(bc_.cards.discardPile[index], false).dump();
+        if (task == CardSelectTask::EXHUME) return cardRow(bc_.cards.exhaustPile[index], false).dump();
+        return cardRow(bc_.cards.hand[index], true).dump();
+    }
+
+    std::string selectCard(int index) {
+        if (!hasReset_ || terminal() || truncated_) throw std::runtime_error("不允许继续已结束场景");
+        const auto indices = selectionIndices();
+        if (std::find(indices.begin(), indices.end(), index) == indices.end()) throw std::invalid_argument("非法选牌对象");
+        return executeDecision(search::Action(search::ActionType::SINGLE_CARD_SELECT, index), -1);
+    }
+
+private:
+    std::string executeDecision(const search::Action &selected, int action) {
+        // 只从动作执行前已经公开的敌人名字与意图构造历史，不读miscInfo/未来随机值。
+        std::array<std::string, PUBLIC_TARGET_CAPACITY> oldNames{}, oldIntents{};
+        std::array<int, PUBLIC_TARGET_CAPACITY> oldSerials{};
+        for (int i=0;i<PUBLIC_TARGET_CAPACITY;++i) oldSerials[i]=bc_.monsters.arr[i].entitySerial;
+        const int oldTurn = bc_.turn;
+        if (action == PUBLIC_END_TURN) for (int i = 0; i < bc_.monsters.monsterCount; ++i) {
+            if (!bc_.monsters.arr[i].isTargetable()) continue;
+            oldNames[i] = monsterIdStrings[static_cast<int>(bc_.monsters.arr[i].id)];
+            oldIntents[i] = visibleIntent(bc_.monsters.arr[i]);
+        }
+        selected.execute(bc_);
+        ++actionCount_;
+        if (action == PUBLIC_END_TURN && !terminal() && bc_.turn > oldTurn) {
+            for (int i = 0; i < bc_.monsters.monsterCount; ++i) {
+                auto &history = publicHistory_[i];
+                const auto name = std::string(monsterIdStrings[static_cast<int>(bc_.monsters.arr[i].id)]);
+                // 分裂替换的实体不继承旧怪物的行动历史。
+                if (bc_.monsters.arr[i].entitySerial != oldSerials[i] || name != oldNames[i]) {
+                    history = {}; history.name = name; continue;
+                }
+                history.previousIntent = history.lastIntent;
+                history.lastIntent = oldIntents[i];
+                ++history.completedTurns;
+                if (oldIntents[i] == "SLEEP") ++history.sleepTurns;
+                if (bc_.monsters.arr[i].id == MonsterId::GREMLIN_WIZARD) {
+                    if (oldIntents[i] == "UNKNOWN") ++history.chargeTurns;
+                    else if (oldIntents[i] == "ATTACK" && bc_.ascension < 17) history.chargeTurns = 0;
+                }
+            }
+        }
+        for (int i=0;i<PUBLIC_TARGET_CAPACITY;++i) if (oldSerials[i]!=bc_.monsters.arr[i].entitySerial) publicHistory_[i]={};
+        const bool won = terminal() && bc_.outcome == Outcome::PLAYER_VICTORY;
+        if (won && gc_->relics.has(R::BURNING_BLOOD)) bc_.player.heal(6);
+        truncated_ = !terminal() && actionCount_ >= maxActions_;
+        const double reward = won ? 1.0 + 0.5 * bc_.player.curHp / bc_.player.maxHp : 0.0;
+        Json info = {{"action_count", actionCount_}, {"outcome", static_cast<int>(bc_.outcome)},
+            {"truncation_reason", truncated_ ? "external_action_budget" : ""}, {"reward_version", "battle_reward_v1"},
+            {"exit_effects_applied", won}, {"player_hp", bc_.player.curHp}, {"player_max_hp", bc_.player.maxHp}};
+        if (terminal()) {
+            const int originalGold = gc_->gold;
+            std::map<std::pair<int,int>,int> deckDelta;
+            for (const auto &card : gc_->deck.cards) --deckDelta[{static_cast<int>(card.id),card.getUpgraded()}];
+            bc_.exitBattle(*gc_);
+            for (const auto &card : gc_->deck.cards) ++deckDelta[{static_cast<int>(card.id),card.getUpgraded()}];
+            // 被击杀盗贼留下的已偷金币在本战出口收回，逃跑金币不收回。
+            if (won) gc_->gold += gc_->info.stolenGold;
+            info["battle_exit"] = {{"gold_delta", gc_->gold - originalGold}, {"deck_changes", Json::array()}};
+            for (const auto &entry : deckDelta) if (entry.second != 0)
+                info["battle_exit"]["deck_changes"].push_back({{"name", sourceCardName(static_cast<CardId>(entry.first.first))}, {"upgrade_count", entry.first.second}, {"count_delta", entry.second}});
+            for (auto &card : bc_.cards.stasisCards) card = CardInstance(CardId::INVALID);
+        }
+        return Json{{"observation", observeJson()}, {"reward", reward}, {"terminated", terminal()},
+            {"truncated", truncated_}, {"info", info}}.dump();
+    }
+};
+
+// 独立注册入口；旧PublicBattleEnv仍保持原观测字段。
+class IroncladBattleEnv : public PublicBattleEnv {
+public:
+    explicit IroncladBattleEnv(int maxActions) : PublicBattleEnv(maxActions, true) {}
+};
+}
+
+void registerIntegratedCardEnv(pybind11::module_ &module) {
+    module.attr("IRONCLAD_REGISTRY_SHA256") = IRONCLAD_REGISTRY_SHA256;
+    module.attr("IRONCLAD_CONTRACT_SHA256") = IRONCLAD_CONTRACT_SHA256;
+    pybind11::class_<IroncladBattleEnv>(module, "IroncladExpandedBattleEnv")
+        .def(pybind11::init<int>(), pybind11::arg("max_actions") = PUBLIC_MAX_ACTIONS)
+        .def("reset_scene", &IroncladBattleEnv::resetScene)
+        .def("step", &IroncladBattleEnv::step)
+        .def("observation", &IroncladBattleEnv::observation)
+        .def("action_mask", &IroncladBattleEnv::actionMask)
+        .def("allocated_card_count", &IroncladBattleEnv::allocationCount)
+        .def("selection_indices", &IroncladBattleEnv::selectionIndices)
+        .def("selection_card", &IroncladBattleEnv::selectionCard)
+        .def("select_card", &IroncladBattleEnv::selectCard);
+}
